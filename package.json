{
  "name": "highland-destinations-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express and MongoDB backend for Highland Destinations",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"api/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"api/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"api/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"api/**/*.ts\" --fix",
    "start": "node dist/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:debug": "tsx watch --inspect src/main.ts",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "joi": "latest",
    "mongoose": "latest",
    "pino": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "prettier": "latest",
    "typescript": "^5.9.0",
    "typescript-eslint": "latest",
    "tsx": "latest"
  }
}
